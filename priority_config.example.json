{
  "$schema": "job-hunter-priority-config-v1",
  "说明": "修改本文件即可更换优先级，无需改代码。层级 level 越小越优先；match_keywords 用于给岗位归类（命中即算该行业/岗位）。复制本文件为 priority_config.json 后使用。示例内容仅为演示结构，请替换成你自己的偏好。",
  "max_batch": 20,
  "weights": {
    "industry": 10,
    "role": 5
  },
  "exclude_keywords": [
    "关键词示例A",
    "关键词示例B"
  ],
  "industry_priority": [
    { "level": 1, "name": "行业A（示例：替换为你最想去的行业）", "match_keywords": ["关键词A1", "关键词A2"] },
    { "level": 2, "name": "行业B（示例）", "match_keywords": ["关键词B1", "关键词B2"] },
    { "level": 3, "name": "行业C（示例）", "match_keywords": ["关键词C1"] },
    { "level": 4, "name": "其他（兜底，勿删）", "match_keywords": [] }
  ],
  "role_priority": [
    { "level": 1, "name": "岗位A（示例：替换为你最想做的岗位）", "match_keywords": ["关键词A1", "关键词A2"] },
    { "level": 2, "name": "岗位B（示例）", "match_keywords": ["关键词B1", "关键词B2"] },
    { "level": 3, "name": "岗位C（示例）", "match_keywords": ["关键词C1"] },
    { "level": 4, "name": "其他（兜底，勿删）", "match_keywords": [] }
  ]
}
